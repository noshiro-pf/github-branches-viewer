{
  "name": "github-branches-viewer",
  "version": "0.0.0",
  "private": false,
  "author": "noshiro-pf <noshiro.pf@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm run type-check && pnpm run lint",
    "check-all": "tsx ./scripts/cmd/check-all.mjs",
    "check:ext": "tsx ./scripts/cmd/check-ext.mjs",
    "dev": "vite",
    "fmt": "format-diff-from origin/main",
    "fmt:full": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "tsc": "tsc --noEmit",
    "tscw": "tsc --noEmit --watch -p ./tsconfig.json",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@wooorm/starry-night": "^3.8.0",
    "axios": "^1.12.2",
    "github-markdown-css": "^5.8.1",
    "hast-util-to-html": "^9.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-data-forge": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.38.0",
    "eslint-config-typed": "1.7.1",
    "prettier": "3.6.2",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "2.5.19",
    "ts-repo-utils": "7.7.2",
    "ts-type-forge": "2.3.0",
    "typescript": "5.9.3",
    "vite": "7.1.11",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.24.0",
  "volta": {
    "node": "25.0.0",
    "npm": "11.6.2"
  }
}
